config.stopBubbling = true

# Carry Spring's @Value / @Qualifier onto the constructor parameters that
# @RequiredArgsConstructor generates, so @Value on a final field is honoured
# for constructor injection (the project convention: field injection is banned).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
