# Copy to .env and fill in. .env is gitignored; this template is committed.
# Consumed by docker-compose.yml via ${VAR} interpolation.

# MySQL root password (used by the API datasource and the mysql healthcheck)
MYSQL_ROOT_PASSWORD=

# Database name — must match the name created in db/schema.sql (ecommerce_db)
MYSQL_DATABASE=ecommerce_db
